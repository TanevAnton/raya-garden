              }
            ],
            "url": {
              "raw": "{{base_url}}/folios/{{storno_folio_id}}/charges/bulk",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "folios",
                "{{storno_folio_id}}",
                "charges",
                "bulk"
              ]
            },
            "description": "Върнатият ред с отрицателно количество, с датата на връщането.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"charges\": [\n    {\n      \"text\": \"Тирамису\",\n      \"price\": \"5.90\",\n      \"qty\": -1,\n      \"currency\": \"{{currency}}\",\n      \"service_date\": \"{{refund_date}}\",\n      \"print_text\": \"QR R-3Q9V #4 УНП {{usn}}\",\n      \"charge_template_id\": {{template_kitchen}}\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('ok', () => pm.expect(pm.response.code).to.be.oneOf([200,201,204]));"
                ]
              }
            }
          ]
        },
        {
          "name": "3. Отрицателно плащане",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/folios/{{storno_folio_id}}/credit_items",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "folios",
                "{{storno_folio_id}}",
                "credit_items"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"credit_item\": {\n    \"currency\": \"{{currency}}\",\n    \"value\": \"-5.90\",\n    \"text\": \"Сторно: Продажба чрез ФУ с ИН {{printer_id}}\",\n    \"payment_type\": \"card\",\n    \"payment_sub_type\": \"\",\n    \"reference\": \"QR R-3Q9V #4 УНП {{usn}}\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('ok', () => pm.expect(pm.response.code).to.be.oneOf([200,201,204]));"
                ]
              }
            }
          ]
        },
        {
          "name": "4. Затвори (без вид документ)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/folios/{{storno_folio_id}}/close",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "folios",
                "{{storno_folio_id}}",
                "close"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('ok', () => pm.expect(pm.response.code).to.be.oneOf([200,201,204]));"
                ]
              }
            }
          ]
        },
        {
          "name": "5. Провери",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/folios/{{storno_folio_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "folios",
                "{{storno_folio_id}}"
              ]
            },
            "description": "Очаква се: −5,90, баланс 0, затворено."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('ok', () => pm.expect(pm.response.code).to.be.oneOf([200,201,204]));"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "https://sky-eu1.clock-software.com/base_api/<абонамент>/<акаунт>"
    },
    {
      "key": "api_user",
      "value": ""
    },
    {
