{
  "name": "raya-garden",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Park Hotel RAYA Garden — luxury cinematic website",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --host",
    "prerender:bots": "node scripts/prerender-bots.mjs",
    "sitemap": "node scripts/generate-sitemap.mjs",
    "check:meta": "node scripts/check-meta-events.mjs",
    "covers:pdf": "node scripts/generate-pdf-covers.mjs",
    "migrate": "node scripts/migrate-to-sanity.mjs",
    "seed:restaurant-gallery": "node scripts/seed-restaurant-gallery.mjs",
    "seed:winery-gallery": "node scripts/seed-winery-gallery.mjs",
    "studio:dev": "sanity dev",
    "studio:deploy": "sanity deploy",
    "test:qr": "node --test tests/qr/api.test.mjs tests/qr/pay.test.mjs",
    "qr:php-check": "vendor/bin/phpcs -q --standard=PHPCompatibility --runtime-set testVersion 7.3 --extensions=php public/api",
    "test:qr:e2e": "node --test --test-concurrency=1 tests/qr/e2e.test.mjs tests/qr/e2e-pay.test.mjs",
    "qr:password": "node scripts/qr-server-config.mjs --print",
    "qr:print": "node scripts/qr-print.mjs"
  },
  "dependencies": {
    "@sanity/client": "^7.22.0",
    "@sanity/image-url": "^2.1.1",
    "lucide-react": "^0.453.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^6.27.0"
  },
  "devDependencies": {
    "@portabletext/react": "^6.2.0",
    "@sanity/vision": "^5.25.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "dotenv": "^17.4.2",
    "postcss": "^8.4.47",
    "puppeteer": "^25.10.0",
    "qrcode": "^1.5.4",
    "sanity": "^5.25.1",
    "styled-components": "^6.4.1",
    "tailwindcss": "^3.4.14",
    "vite": "^5.4.10"
  }
}
